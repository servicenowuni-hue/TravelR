{
  "name": "u_travel_request",
  "label": "Travel Request",
  "extends_table": "task",
  "create_access_controls": true,
  "create_audit_table": true,
  "fields": [
    {
      "name": "u_requested_by",
      "label": "Requested By",
      "type": "reference",
      "reference": "sys_user"
    },
    {
      "name": "u_destination",
      "label": "Destination",
      "type": "string",
      "max_length": 100
    },
    {
      "name": "u_purpose",
      "label": "Purpose",
      "type": "string",
      "max_length": 500
    },
    {
      "name": "u_start_date",
      "label": "Start Date",
      "type": "date"
    },
    {
      "name": "u_end_date",
      "label": "End Date",
      "type": "date"
    },
    {
      "name": "u_estimated_cost",
      "label": "Estimated Cost",
      "type": "currency"
    },
    {
      "name": "u_status",
      "label": "Status",
      "type": "choice",
      "choices": [
        {"value": "draft", "label": "Draft"},
        {"value": "submitted", "label": "Submitted"},
        {"value": "approved", "label": "Approved"},
        {"value": "rejected", "label": "Rejected"}
      ]
    }
  ]
}